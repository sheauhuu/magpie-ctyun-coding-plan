{
  "name": "magpie-ctyun-coding-plan",
  "version": "0.1.0",
  "description": "天翼云 Coding Plan 的 MAGPIE 供应商插件，支持两种登录方式、模型发现与原生额度窗口。",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "scripts/forget-credentials.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.mjs && node --check src/session.mjs && node --check src/browser.mjs && node --check src/plugin.mjs && node --check src/model-profiles.mjs && node --check src/sse.mjs",
    "test:live": "node scripts/live-check.mjs",
    "browser:install": "playwright install chromium",
    "credentials:forget": "node scripts/forget-credentials.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "magpie",
    "opencode-plugin",
    "ctyun",
    "coding-plan"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sheauhuu/magpie-ctyun-coding-plan.git"
  },
  "license": "MIT",
  "dependencies": {
    "tough-cookie": "^6.0.2"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "playwright": "^1.64.1"
  },
  "magpie": {
    "maxConcurrency": 4,
    "icon": "data:image/x-icon;base64,"
  }
}
